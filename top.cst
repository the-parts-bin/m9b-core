// Tang Nano 9K constraints
// Part Number: GW1NR-LV9QN88PC6/I5

// ---------------------------------------------------------------
// Clock oscillator (27 MHz)
// ---------------------------------------------------------------
IO_LOC  "ext_clk" 52;
IO_PORT "ext_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------
// Key 1
IO_LOC  "reset" 3;  
IO_PORT "reset" PULL_MODE=UP;

// ---------------------------------------------------------------
// Serial port
// ---------------------------------------------------------------
IO_LOC  "txd" 17;
IO_PORT "txd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "rxd" 18;
IO_PORT "rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Second UART port, header J5 (external USB-serial adapter, 3.3 V levels)
IO_LOC  "txd2" 29;
IO_PORT "txd2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "rxd2" 30;
IO_PORT "rxd2" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------
// LEDs
// ---------------------------------------------------------------
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" PULL_MODE=NONE;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" PULL_MODE=NONE;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" PULL_MODE=NONE;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" PULL_MODE=NONE;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" PULL_MODE=NONE;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" PULL_MODE=NONE;

// ---------------------------------------------------------------
// SPI flash (P25Q32U)
// ---------------------------------------------------------------
IO_LOC  "flash_clk" 59;
IO_PORT "flash_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_cs_n" 60;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_mosi" 61;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "flash_miso" 62;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------
// SD card slot (SPI mode)
// ---------------------------------------------------------------
IO_LOC  "sd_clk" 36;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_mosi" 37;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_cs_n" 38;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_miso" 39;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---------------------------------------------------------------
// USB host, low speed (as in hi631's Tang Nano 9K NES): D- 25, D+ 26 on
// header J5, plus 5V and GND (J6) to the socket. Internal pull-downs (the
// host's 15k to GND works too); 4 mA. See README, USB host.
// ---------------------------------------------------------------
IO_LOC  "usb_dm" 25;
IO_PORT "usb_dm" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_LOC  "usb_dp" 26;
IO_PORT "usb_dp" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
// Second port: D- 27, D+ 28, also on J5.
IO_LOC  "usb2_dm" 27;
IO_PORT "usb2_dm" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_LOC  "usb2_dp" 28;
IO_PORT "usb2_dp" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;

// ---------------------------------------------------------------
// HDMI port
// ---------------------------------------------------------------
IO_LOC "tmds_clk_p" 69,68;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[0]" 71,70;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[1]" 73,72;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_data_p[2]" 75,74;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=8;
