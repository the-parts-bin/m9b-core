// Pins as in ../../top.cst (27 MHz oscillator, button S2, both UART TX pins, LEDs).
IO_LOC  "ext_clk" 52;
IO_PORT "ext_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "reset" 3;
IO_PORT "reset" PULL_MODE=UP;
IO_LOC  "txd" 17;
IO_PORT "txd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "txd2" 29;
IO_PORT "txd2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" PULL_MODE=NONE;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" PULL_MODE=NONE;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" PULL_MODE=NONE;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" PULL_MODE=NONE;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" PULL_MODE=NONE;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" PULL_MODE=NONE;
